{
  "include": ["server/", "user/", "utils/", "knip.config.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "target": "esnext",
    "outDir": "dist-server",
    "isolatedModules": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./server/*"]
    },
    "noEmit": true
  }
}
